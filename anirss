#!/usr/bin/env python3
"""anirss launcher — locates anirss_lib next to itself and runs main()."""
import os
import sys

# realpath resolves the symlink chain (e.g. /usr/bin/anirss ->
# /usr/lib/anirss/anirss, or ~/.local/bin/anirss -> ~/repos/anirss/anirss) so
# the launcher always finds its sibling anirss_lib/.
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from anirss_lib.main import main

if __name__ == "__main__":
    main()
