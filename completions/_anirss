#compdef anirss
# zsh completion for anirss.
#
# Feed names come from ~/.local/state/anirss/feeds.txt — refreshed on every
# successful qBittorrent login (or run `anirss -Sy` to force).
#
# This file is loaded by zsh's compsys via `autoload -Uz`. The whole file
# *is* the body of the `_anirss` completion function — no inner wrapper
# needed.

local cache="${XDG_STATE_HOME:-$HOME/.local/state}/anirss/feeds.txt"
local -a ops feeds

ops=(
    '-c:use one of the configured qBittorrent clients'
    '--client:use one of the configured qBittorrent clients'
    '-e:start on a specific endpoint'
    '--endpoint:start on a specific endpoint'
    '-Q:list subscribed feeds'
    '-Qj:list subscribed feeds as JSON'
    '-S:subscribe to a URL (skip search/refine)'
    '-Sh:subscribe — save under hidden_base'
    '-Sy:refresh the feed cache'
    '-R:remove feed + rule'
    '-Rs:remove + qB torrents (keep files)'
    '-Rn:remove + files (keep torrents)'
    '-Rns:remove + torrents + files'
    '-Rh:remove from the hidden tree'
    '-Rsh:remove + torrents, hidden tree'
    '-Rnh:remove + files, hidden tree'
    '-Rnsh:remove + torrents + files, hidden tree'
    '-T:upload a local .torrent file'
    '-Th:upload — save under hidden_base'
    '--noconfirm:skip the y/N prompt for -R*'
    '--no-seed:set qB to pause torrents at ratio 0'
    '--config:print resolved config and exit'
    '--migrate-config:append new default config sections'
    '--serve:serve the JSON HTTP API (--host, --port)'
    '--refresh-on-demand:let qBittorrent poll on-demand endpoint feeds'
    '--version:print version'
    '-h:help'
    '--help:help'
)

# After -c / --client: the configured client names.
if [[ $words[CURRENT-1] == (-c|--client) ]]; then
    local -a clients
    clients=("${(@f)$(anirss --_clients 2>/dev/null)}")
    _wanted clients expl 'qBittorrent client' compadd -a clients
    return
fi

# `-c NAME` may come before the operation; the operation is the word after it.
local -i op=2
while [[ $words[op] == (-c|--client) ]]; do
    (( op += 2 ))
done

# First word after the command (and any -c NAME): offer the operation flags.
if (( CURRENT == op )); then
    _describe -t operations 'operation' ops
    return
fi

# After -R / -Rs / -Rn / -Rns / -R*h: complete feed names from the cache.
# After -T / -Th: complete *.torrent files from the filesystem.
case $words[op] in
    (-R|-Rs|-Rn|-Rns|-Rh|-Rsh|-Rnh|-Rnsh)
        if [[ -f $cache ]]; then
            if [[ -n $(find $cache -mmin +1440 -print 2>/dev/null) ]]; then
                _message -r '(feed cache may be stale — anirss -Sy)'
            fi
            feeds=("${(@f)$(<$cache)}")
            # `compadd -a` takes the array as raw values (no value:description
            # parsing), so feed names containing `:` (e.g. "Dr. Stone: ...")
            # aren't split into pseudo-descriptions. compsys still handles
            # quoting on insertion for names that contain spaces.
            _wanted feeds expl 'feed' compadd -a feeds
        else
            _message -r 'no cached feeds — run: anirss -Sy'
        fi
        ;;
    (-T|-Th)
        _files -g '*.torrent'
        ;;
esac
